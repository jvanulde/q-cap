# Local Docker Compose settings. Copy this file to .env and replace the token.
QCAP_REGISTRY_PORT=8080
QCAP_REGISTRY_TOKEN=replace-me-before-sharing

# Optional OIDC administration. Set all three; remove the legacy token after PAT migration.
QCAP_REGISTRY_OIDC_ISSUER=
QCAP_REGISTRY_OIDC_CLIENT_ID=
QCAP_REGISTRY_OIDC_ADMIN_SUBJECTS=
